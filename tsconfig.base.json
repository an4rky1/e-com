{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@front/source"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@auth/contracts": ["./libs/contracts/src/index.ts"],
      "@auth/contracts/*": ["./libs/contracts/src/*"],
      "@auth/ddd-core": ["./libs/ddd-core/src/index.ts"],
      "@auth/ddd-core/*": ["./libs/ddd-core/src/*"],
      "@auth/gateway": ["./libs/gateway/src/index.ts"],
      "@auth/gateway/*": ["./libs/gateway/src/*"],
      "@auth/testing": ["./libs/testing/src/index.ts"],
      "@auth/testing/*": ["./libs/testing/src/*"],
      "@auth/domains/access-control": ["./libs/domains/access-control/src/index.ts"],
      "@auth/domains/account-security": ["./libs/domains/account-security/src/index.ts"],
      "@auth/domains/api-key": ["./libs/domains/api-key/src/index.ts"],
      "@auth/domains/audit-log": ["./libs/domains/audit-log/src/index.ts"],
      "@auth/domains/auth-gateway": ["./libs/domains/auth-gateway/src/index.ts"],
      "@auth/domains/credential-vault": ["./libs/domains/credential-vault/src/index.ts"],
      "@auth/domains/identity": ["./libs/domains/identity/src/index.ts"],
      "@auth/domains/mfa": ["./libs/domains/mfa/src/index.ts"],
      "@auth/domains/notification": ["./libs/domains/notification/src/index.ts"],
      "@auth/domains/session-token": ["./libs/domains/session-token/src/index.ts"],
      "@auth/platform/config": ["./libs/platform/config/src/index.ts"],
      "@auth/platform/error-handling": ["./libs/platform/error-handling/src/index.ts"],
      "@auth/platform/health": ["./libs/platform/health/src/index.ts"],
      "@auth/platform/shutdown": ["./libs/platform/shutdown/src/index.ts"],
      "@auth/infra/grpc": ["./libs/infra/grpc/src/index.ts"],
      "@auth/infra/kafka": ["./libs/infra/kafka/src/index.ts"],
      "@auth/infra/outbox": ["./libs/infra/outbox/src/index.ts"],
      "@auth/infra/prisma": ["./libs/infra/prisma/src/index.ts"],
      "@auth/infra/rate-limit": ["./libs/infra/rate-limit/src/index.ts"]
    }
  }
}
