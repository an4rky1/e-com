/**
 * access-control service schema — source of truth, pulled from the live database DDL.
 *
 * @remarks The service's Prisma client is generated from this file into
 * src/generated/prisma. Because each service generates its own client from its own
 * schema, table ownership is a compile error rather than a convention: no other
 * service's model is reachable from here.
 */

generator client {
  provider        = "prisma-client-js"
  output   = "../../libs/domains/access-control/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model outbox_dead_letters {
  outbox_id     String        @id @db.Uuid
  reason        String
  payload       Json
  last_error    String?
  attempts      Int
  trace_id      String?
  failed_at     DateTime      @default(now()) @db.Timestamptz(6)
  outbox_events outbox_events @relation(fields: [outbox_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model outbox_events {
  id                  String               @id @db.Uuid
  type                String
  aggregate_type      String
  aggregate_id        String
  topic               String
  payload             Json
  dedup_key           String
  status              OutboxStatus @default(pending)
  attempts            Int                  @default(0)
  next_attempt_at     DateTime             @default(now()) @db.Timestamptz(6)
  last_error          String?
  locked_at           DateTime?            @db.Timestamptz(6)
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  published_at        DateTime?            @db.Timestamptz(6)
  trace_id            String
  outbox_dead_letters outbox_dead_letters?

  @@unique([dedup_key, type], map: "outbox_events_dedup_idx")
  @@index([status, next_attempt_at, created_at], map: "outbox_events_claim_idx")
  @@index([status, attempts], map: "outbox_events_sweep_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model policies {
  id            String   @id @db.Uuid
  role          String
  permission    String
  effect        PolicyEffect
  conditions    Json     @default("[]")
  priority      Int      @default(0)
  resource_type String?
  description   String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  roles         roles    @relation(fields: [role], references: [name], onDelete: Cascade, onUpdate: NoAction)

  @@index([role])
  @@index([role, resource_type], map: "policies_role_resource_idx")
}

model role_assignments {
  id         String    @id @db.Uuid
  user_id    String    @db.Uuid
  role       String
  granted_by String?   @db.Uuid
  granted_at DateTime  @default(now()) @db.Timestamptz(6)
  expires_at DateTime? @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  roles      roles     @relation(fields: [role], references: [name], onUpdate: NoAction)
}

model roles {
  name             String             @id
  permissions      String[]           @default([])
  description      String?
  is_system        Boolean            @default(false)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  policies         policies[]
  role_assignments role_assignments[]
}

enum PolicyEffect {
  allow
  deny
}

enum OutboxStatus {
  pending
  processing
  published
  failed
  dlq
}
