/**
 * account-security service schema — source of truth, pulled from the live database DDL.
 *
 * @remarks The service's Prisma client is generated from this file into
 * src/generated/prisma. Because each service generates its own client from its own
 * schema, table ownership is a compile error rather than a convention: no other
 * service's model is reachable from here.
 */

generator client {
  provider        = "prisma-client-js"
  output   = "../../libs/domains/account-security/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model login_history {
  login_id    String   @id @db.Uuid
  user_id     String   @db.Uuid
  session_id  String?  @db.Uuid
  fingerprint String
  country     String?
  latitude    Float?
  longitude   Float?
  occurred_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, fingerprint], map: "login_history_user_fingerprint_idx")
  @@index([user_id, occurred_at(sort: Desc)], map: "login_history_user_occurred_idx")
}

model outbox_dead_letters {
  outbox_id     String        @id @db.Uuid
  reason        String
  payload       Json
  last_error    String?
  attempts      Int
  trace_id      String?
  failed_at     DateTime      @default(now()) @db.Timestamptz(6)
  outbox_events outbox_events @relation(fields: [outbox_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model outbox_events {
  id                  String               @id @db.Uuid
  type                String
  aggregate_type      String
  aggregate_id        String
  topic               String
  payload             Json
  dedup_key           String
  status              String               @default("pending")
  attempts            Int                  @default(0)
  next_attempt_at     DateTime             @default(now()) @db.Timestamptz(6)
  last_error          String?
  locked_at           DateTime?            @db.Timestamptz(6)
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  published_at        DateTime?            @db.Timestamptz(6)
  trace_id            String
  outbox_dead_letters outbox_dead_letters?

  @@unique([dedup_key, type], map: "outbox_events_dedup_idx")
  @@index([status, next_attempt_at, created_at], map: "outbox_events_claim_idx")
  @@index([status, attempts], map: "outbox_events_sweep_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model security_signals {
  signal_id   String   @id @db.Uuid
  user_id     String   @db.Uuid
  signal_type String
  risk_score  Int
  detected_at DateTime @default(now()) @db.Timestamptz(6)
  details     Json     @default("{}")

  @@index([user_id, detected_at(sort: Desc)], map: "security_signals_user_detected_idx")
  @@index([user_id, signal_type, detected_at(sort: Desc)], map: "security_signals_user_type_idx")
}


