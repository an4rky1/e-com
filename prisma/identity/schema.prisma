/**
 * identity service schema — source of truth, pulled from the live database DDL.
 *
 * @remarks The service's Prisma client is generated from this file into
 * src/generated/prisma. Because each service generates its own client from its own
 * schema, table ownership is a compile error rather than a convention: no other
 * service's model is reachable from here.
 */

generator client {
  provider        = "prisma-client-js"
  output   = "../../libs/domains/identity/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model idempotency_keys {
  key        String   @id
  response   Json
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idempotency_keys_created_idx")
}

model outbox_dead_letters {
  outbox_id     String        @id @db.Uuid
  reason        String
  payload       Json
  last_error    String?
  attempts      Int
  trace_id      String?
  failed_at     DateTime      @default(now()) @db.Timestamptz(6)
  outbox_events outbox_events @relation(fields: [outbox_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model outbox_events {
  id                  String               @id @db.Uuid
  type                String
  aggregate_type      String
  aggregate_id        String
  topic               String
  payload             Json
  dedup_key           String
  status              OutboxStatus @default(pending)
  attempts            Int                  @default(0)
  next_attempt_at     DateTime             @default(now()) @db.Timestamptz(6)
  last_error          String?
  locked_at           DateTime?            @db.Timestamptz(6)
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  published_at        DateTime?            @db.Timestamptz(6)
  trace_id            String
  outbox_dead_letters outbox_dead_letters?

  @@unique([dedup_key, type], map: "outbox_events_dedup_idx")
  @@index([status, next_attempt_at, created_at], map: "outbox_events_claim_idx")
  @@index([status, attempts], map: "outbox_events_sweep_idx")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model users {
  id             String    @id @db.Uuid
  email          String
  display_name   String?
  locale         String    @default("en")
  status         UserStatus @default(pending_verification)
  email_verified Boolean   @default(false)
  version        Int       @default(1)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)
  deleted_reason String?

  auth_identities user_auth_identities[]

  @@index([status, created_at(sort: Desc)], map: "users_status_created_idx")
}

/// An identity-provider account linked to a user: what a person *returns* with on every
/// OAuth sign-in. `(provider, subject)` is unique platform-wide, so one provider account
/// can never be attached to two local users, and one user may carry several links.
model user_auth_identities {
  id         String   @id @db.Uuid
  user_id    String   @db.Uuid
  provider   String
  subject    String
  email      String?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, subject], map: "user_auth_identities_provider_subject_idx")
  @@index([user_id], map: "user_auth_identities_user_idx")
}

enum UserStatus {
  pending_verification
  active
  suspended
  locked
  deleted
  // A browser's placeholder account: issued to an anonymous shopper so the basket, the
  // orders and the fingerprint all have a user id to hang on, and never authenticatable —
  // it has no credential and no mailbox that could receive one.
  guest
}

enum OutboxStatus {
  pending
  processing
  published
  failed
  dlq
}
