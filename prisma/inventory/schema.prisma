/**
 * inventory service schema — source of truth for the stock ledger.
 *
 * @remarks The service's Prisma client is generated from this file into
 * src/generated/prisma. Because each service generates its own client from its own
 * schema, table ownership is a compile error rather than a convention: no other
 * service's model is reachable from here.
 *
 * @remarks `stock_levels` is keyed by `(sku, warehouse_id)` because availability is a
 * fact about one SKU in one warehouse, not about the SKU globally. `available` is
 * deliberately absent: it is `on_hand - reserved - safety`, and a stored copy would
 * drift from its own inputs the first time a reserve and an adjustment commit in
 * different orders.
 *
 * @remarks `reservations.order_id` is unique. One order holds at most one reservation
 * ever, which is what makes "reserve is idempotent per order" a database constraint
 * rather than a check that races.
 */

generator client {
  provider        = "prisma-client-js"
  output   = "../../libs/domains/inventory/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model stock_levels {
  id           String   @id @db.Uuid
  sku          String
  warehouse_id String
  /// Units physically present. Never goes below `reserved` or below zero.
  on_hand      Int      @default(0)
  /// Units promised to an active reservation. The part of `on_hand` that may not be sold.
  reserved     Int      @default(0)
  /// Buffer that may not be sold at all. Applied when a row is first created.
  safety       Int      @default(0)
  /// Write counter: optimistic-concurrency token, and the version tail of `stock.changed`.
  version      Int      @default(1)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([sku, warehouse_id], map: "stock_levels_sku_warehouse_unique")
  @@index([warehouse_id], map: "stock_levels_warehouse_idx")
}

model reservations {
  id           String   @id @db.Uuid
  /// Unique on purpose: idempotent reserve per order is enforced by the database.
  order_id     String   @unique(map: "reservations_order_id_unique")
  warehouse_id String
  /// active | released | shipped. `released` and `shipped` are terminal.
  status       String   @default("active")
  version      Int      @default(1)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  lines        reservation_lines[]

  @@index([status], map: "reservations_status_idx")
}

model reservation_lines {
  id             String        @id @db.Uuid
  reservation_id String        @db.Uuid
  sku            String
  /// Units still reserved by this line. Ship decrements it; release zeroes it.
  qty            Int
  reservation    reservations  @relation(fields: [reservation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([reservation_id], map: "reservation_lines_reservation_idx")
}

model stock_adjustments {
  id            String   @id @db.Uuid
  sku           String
  warehouse_id  String
  /// Signed change to `on_hand`. May be negative; the aggregate refuses a result below zero.
  delta         Int
  reason        String
  /// Caller-supplied correlation id: repeating an adjustment with this id is a no-op.
  adjustment_id String   @unique(map: "stock_adjustments_adjustment_id_unique")
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([sku, warehouse_id], map: "stock_adjustments_sku_warehouse_idx")
}

model outbox_dead_letters {
  outbox_id     String        @id @db.Uuid
  reason        String
  payload       Json
  last_error    String?
  attempts      Int
  trace_id      String?
  failed_at     DateTime      @default(now()) @db.Timestamptz(6)
  outbox_events outbox_events @relation(fields: [outbox_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model outbox_events {
  id                  String               @id @db.Uuid
  type                String
  aggregate_type      String
  aggregate_id        String
  topic               String
  payload             Json
  dedup_key           String
  status              OutboxStatus @default(pending)
  attempts            Int                  @default(0)
  next_attempt_at     DateTime             @default(now()) @db.Timestamptz(6)
  last_error          String?
  locked_at           DateTime?            @db.Timestamptz(6)
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  published_at        DateTime?            @db.Timestamptz(6)
  trace_id            String
  outbox_dead_letters outbox_dead_letters?

  @@unique([dedup_key, type], map: "outbox_events_dedup_idx")
  @@index([status, next_attempt_at, created_at], map: "outbox_events_claim_idx")
  @@index([status, attempts], map: "outbox_events_sweep_idx")
}

enum OutboxStatus {
  pending
  processing
  published
  failed
  dlq
}
