/**
 * auth-flow service schema — source of truth, pulled from the live database DDL.
 *
 * @remarks The service's Prisma client is generated from this file into
 * src/generated/prisma. Because each service generates its own client from its own
 * schema, table ownership is a compile error rather than a convention: no other
 * service's model is reachable from here.
 */

generator client {
  provider        = "prisma-client-js"
  output   = "../../libs/domains/auth-flow/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model auth_flow_steps {
  id          BigInt     @id @default(autoincrement())
  flow_id     String     @db.Uuid
  from_status String
  to_status   String
  occurred_at DateTime   @default(now()) @db.Timestamptz(6)
  auth_flows  auth_flows @relation(fields: [flow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([flow_id, occurred_at, id], map: "auth_flow_steps_flow_idx")
}

model auth_flows {
  id              String            @id @db.Uuid
  strategy        AuthFlowType
  status          AuthFlowState @default(awaiting_credential)
  user_id         String?           @db.Uuid
  device_id       String?
  client_ip       String?
  user_agent      String?
  attempt_count   Int               @default(0)
  max_attempts    Int
  started_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  expires_at      DateTime          @db.Timestamptz(6)
  completed_at    DateTime?         @db.Timestamptz(6)
  failure_reason  String?
  abort_reason    String?
  version         Int               @default(1)
  auth_flow_steps auth_flow_steps[]

  @@index([user_id, started_at(sort: Desc)], map: "auth_flows_user_started_idx")
}

model outbox_dead_letters {
  outbox_id     String        @id @db.Uuid
  reason        String
  payload       Json
  last_error    String?
  attempts      Int
  trace_id      String?
  failed_at     DateTime      @default(now()) @db.Timestamptz(6)
  outbox_events outbox_events @relation(fields: [outbox_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model outbox_events {
  id                  String               @id @db.Uuid
  type                String
  aggregate_type      String
  aggregate_id        String
  topic               String
  payload             Json
  dedup_key           String
  status              OutboxStatus @default(pending)
  attempts            Int                  @default(0)
  next_attempt_at     DateTime             @default(now()) @db.Timestamptz(6)
  last_error          String?
  locked_at           DateTime?            @db.Timestamptz(6)
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  published_at        DateTime?            @db.Timestamptz(6)
  trace_id            String
  outbox_dead_letters outbox_dead_letters?

  @@unique([dedup_key, type], map: "outbox_events_dedup_idx")
  @@index([status, next_attempt_at, created_at], map: "outbox_events_claim_idx")
  @@index([status, attempts], map: "outbox_events_sweep_idx")
}

enum AuthFlowState {
  awaiting_credential
  awaiting_2fa
  awaiting_step_up
  completed
  failed
  expired
  cancelled
}

enum AuthFlowType {
  login
  register
  reset_password
  magic_link
  step_up
}

enum OutboxStatus {
  pending
  processing
  published
  failed
  dlq
}
