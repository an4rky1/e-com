{
  "name": "@auth/gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/gateway/src",
  "projectType": "library",
  "tags": [
    "type:gateway"
  ],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/gateway/tsconfig.lib.json --noEmit"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/libs/gateway"
      ],
      "options": {
        "jestConfig": "libs/gateway/jest.config.ts"
      }
    }
  }
}
