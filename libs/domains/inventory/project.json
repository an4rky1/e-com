{
  "name": "@shop/domains/inventory",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/domains/inventory/src",
  "projectType": "library",
  "tags": [
    "type:domain",
    "domain:inventory"
  ],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
