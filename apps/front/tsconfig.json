{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    // A leaf application, not a node in a project-reference graph: it imports the contracts
    // library straight out of `libs/`, so `composite` (inherited from the base) would demand
    // rootDir containment and a file list that names every one of those files — TS6059/TS6307 on every
    // `@auth/contracts/http` import. Nothing references this project, so it cannot be composite.
    "composite": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "../..",
    // Sources live outside this directory (`libs/contracts` is imported through `paths`), so
    // the default rootDir — this config's own directory — would put them out of bounds (TS6059).
    "rootDir": "../..",
    "paths": {
      "@/*": ["./apps/front/src/*"],
      "@auth/contracts": ["./libs/contracts/src/index.ts"],
      "@auth/contracts/*": ["./libs/contracts/src/*"]
    },
    "types": ["jest", "node"],
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    // The route specs live outside `src/`; without them the IDE has no project that lists
    // `specs/**` and falls back to a bare program with no `paths` and no node types.
    "specs/**/*.ts",
    "../../apps/front/.next/types/**/*.ts",
    "../../dist/apps/front/.next/types/**/*.ts",
    "index.d.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "node_modules",
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    ".next",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ]
}
