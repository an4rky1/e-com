{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    "jsx": "preserve",
    // The app project is not composite (it imports `libs/` sources), so it cannot be a
    // reference target: `tsc -p` reports TS6310 for a referenced project that does not emit.
    "composite": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    // Same reason as `tsconfig.json`: the contracts library is imported from outside `apps/front`.
    "rootDir": "../..",
    "types": ["jest", "node"]
  },
  "include": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts",
    "specs/**/*.ts"
  ]
}
