{
  "name": "@app/credential-vault",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/credential-vault/src",
  "projectType": "application",
  "tags": [
    "type:app",
    "domain:credential-vault"
  ],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/credential-vault/tsconfig.app.json --noEmit"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TS_NODE_PROJECT=apps/credential-vault/tsconfig.app.json node -r ts-node/register/transpile-only -r tsconfig-paths/register apps/credential-vault/src/main.ts"
      }
    }
  }
}
