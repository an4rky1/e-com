{
  "name": "@app/identity",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/identity/src",
  "projectType": "application",
  "tags": [
    "type:app"
  ],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/identity/tsconfig.app.json --noEmit"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "TS_NODE_PROJECT=apps/identity/tsconfig.app.json node -r ts-node/register/transpile-only -r tsconfig-paths/register apps/identity/src/main.ts"
      }
    }
  }
}
